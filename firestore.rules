rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Photos: a signed-in feed, write once, never edited or deleted.
    match /photos/{photoId} {
      // Only signed-in users can see the feed.
      allow read: if request.auth != null;

      // The owner must be the caller, and the timestamp must come from the server,
      // so nobody can post as someone else or back-date a photo.
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdAt == request.time;

      // Photos cannot be modified or deleted, by anyone.
      allow update, delete: if false;
    }

    // Profiles: readable by signed-in users, writable only by their owner.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
