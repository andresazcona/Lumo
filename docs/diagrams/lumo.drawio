<mxfile host="app.diagrams.net"><diagram name="Deployment" id="deployment"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px;&quot;&gt;Lumo: one image, any Firebase&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#666;&quot;&gt;React · nginx (non-root) · Firebase Auth, Firestore, Storage&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="450.0" y="14" width="800" height="46" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;React SPA, mobile first&lt;br&gt;camera or gallery upload&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="100" as="geometry"/></mxCell><mxCell id="c4" value="Container: ghcr.io/andresazcona/lumo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;opacity=45;" vertex="1" parent="1"><mxGeometry x="360" y="220" width="480" height="260" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;nginx (non-root)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;serves the built SPA&lt;br&gt;SPA fallback for /feed, /profile&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="270" width="400" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;/config.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;written at start from environment variables&lt;br&gt;USE_EMULATORS or FIREBASE_*&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="380" width="400" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Your Firebase project&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;Auth (Google, email)&lt;br&gt;Firestore (photo records)&lt;br&gt;Storage (the images)&lt;br&gt;+ the rules in this repo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="130" width="300" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;docker compose: local emulators&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;Auth 9099 · Firestore 8088 · Storage 9199&lt;br&gt;same rules, no project needed&lt;br&gt;memory only: gone when stopped&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="980" y="450" width="300" height="150" as="geometry"/></mxCell><mxCell id="c9" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#6C8EBF;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#6C8EBF;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="SDK calls (rules enforced)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;strokeWidth=2;fontSize=11;fontColor=#82B366;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="SDK calls (local)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Choosing the backend&lt;/b&gt;&lt;br&gt;• &lt;code&gt;docker compose up&lt;/code&gt;: everything local, nothing leaves your machine&lt;br&gt;• &lt;code&gt;docker run -e FIREBASE_API_KEY=… ghcr.io/andresazcona/lumo&lt;/code&gt;: your own project&lt;br&gt;• values are stripped of quotes before they reach the page: they cannot break out of their string" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="650" width="920" height="100" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;No public demo, on purpose.&lt;/b&gt; People post personal photos here, so Lumo is something you run for your own event, not a service." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="280" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Posting a photo" id="posting-a-photo"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px;&quot;&gt;What happens to a photo, and what the rules enforce&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#666;&quot;&gt;Storage first, then the Firestore record&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="450.0" y="14" width="800" height="46" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1. Pick&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;camera or gallery&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="270" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2. Compress&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;over 3 MB: max 1920 px JPEG,&lt;br&gt;sizes and dimensions recorded&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="130" width="270" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;3. Upload&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;Storage&lt;br&gt;photos/&amp;lt;uid&amp;gt;/&amp;lt;timestamp&amp;gt;.jpg&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="270" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;4. Record&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;Firestore photos/&amp;lt;id&amp;gt;&lt;br&gt;owner, URL, size, server time&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="270" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;5. Feed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;signed-in users only&lt;br&gt;newest first, infinite scroll&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1320" y="130" width="270" height="110" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Storage rules&lt;/b&gt;&lt;br&gt;• only a signed-in user, only into their own folder (photos/&amp;lt;their uid&amp;gt;/…)&lt;br&gt;• only image/* files, under 10 MB&lt;br&gt;• update and delete are denied: a photo is never edited or deleted&lt;br&gt;• reads need a signed-in user" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="300" width="600" height="160" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Firestore rules&lt;/b&gt;&lt;br&gt;• ownerUid must equal the caller: nobody posts as someone else&lt;br&gt;• createdAt must be the server time: nobody back-dates a photo&lt;br&gt;• update and delete are denied for everyone&lt;br&gt;• profiles: readable when signed in, writable only by their owner" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="600" height="160" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;All of this is tested.&lt;/b&gt; tests/rules runs 18 cases against the real Firebase emulators on every push: anonymous access, other people's folders, wrong file types, 10 MB limit, back-dated records, edits and deletes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="300" width="330" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>