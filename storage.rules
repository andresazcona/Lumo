rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos live in photos/<uid>/<file>. Write once, never replaced or deleted.
    match /photos/{userId}/{allPaths=**} {
      allow read: if request.auth != null;

      // You can only upload into your own folder: an image, under 10 MB.
      // Overwrites are an `update`, which is denied below, and deletes are denied too.
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');

      allow update, delete: if false;
    }

    // Avatars: the owner can replace and delete their own.
    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
